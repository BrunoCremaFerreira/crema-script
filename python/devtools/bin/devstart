
#!/usr/bin/env bash

# Title:  Python Development Tools
# Author: Bruno Crema Ferreira - MIT License


#==================================
# Functions
#==================================

devstop() {
    deactivate
    unset DEV_STARTED

    if [ -n "${_OLD_PS1:-}" ] ; then
        PS1="${_OLD_PS1:-}"
        export PS1
        unset _OLD_PS1
    fi
}

devclean() {

    log "Removing Python Temp Files" title

    find . -name "*.pyc" -not -path "./.venv/*" -exec rm -fv {} \;
    find . -name "__pycache__" -not -path "./.venv/*" -exec rm -rfv {} \;

    log "All python temp files were removed." success
}

devpack(){

    log "Package Generation" title

    devclean
    local base_current_dir_name=$(basename "$PWD")
    
    timestamp=$(date +"%Y%m%d.%H.%M.%S")
    output_file="${PACKAGES_DIRECTORY}/${timestamp}-${base_current_dir_name}.zip"

    zip -r "$output_file" . -x "./.*" -x "./*.zip"
    log "Package file '$output_file' was created." success
}


devreq(){

    log "Updating requirements.txt..." title

    temp_file=$(mktemp)

    # Read each line from requirements.txt
    while IFS= read -r line; do

        # Check if the line is empty
        if [[ "$line" == \#* || -z "$line" ]]; then
            echo "$line" >> "$temp_file"
        else
            # Extract package name
            package=$(echo "$line" | cut -d'=' -f1 | xargs)

            # Get the installed version from venv
            version=$(pip show "$package" | grep Version | cut -d' ' -f2)

            # if the version is installed, apend it to temp_file
            if [ -n "$version" ]; then
                log "$package==$version" success
                echo "$package==$version" >> "$temp_file"
            else
                log "$line" warning
                echo "$line" >> "$temp_file"  #  Keeps the original line if the package is not installed
            fi
        fi

    done < requirements.txt

    mv "$temp_file" requirements.txt
    log "requirements.txt was updated." success
}

jup(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi

    if ! pip show jupyter &>/dev/null; then
        python -m pip install jupyter notebook ipykernel
    fi
    jupyter notebook &

}


devtest(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "Running Tests" title
    if ! command -v pytest &>/dev/null; then
        log "pytest not found. Install it with: pip install pytest" error
        return 1
    fi
    if pip show pytest-cov &>/dev/null; then
        pytest --tb=short --cov
    else
        pytest --tb=short
    fi
}

devlint(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "Linting" title
    if command -v ruff &>/dev/null; then
        ruff check .
    elif command -v flake8 &>/dev/null; then
        flake8 .
    else
        log "No linter found. Install ruff with: pip install ruff" error
        return 1
    fi
}

devformat(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "Formatting" title
    if command -v ruff &>/dev/null; then
        ruff format .
    elif command -v black &>/dev/null; then
        black .
    else
        log "No formatter found. Install ruff with: pip install ruff" error
        return 1
    fi
}

devci(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "CI Pipeline" title
    devformat && devlint && devtest
}

devdeps(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "Outdated Packages" title
    pip list --outdated
}

devupgrade(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "Upgrading Packages" title
    while IFS= read -r line; do
        if [[ "$line" == \#* || -z "$line" ]]; then
            continue
        fi
        package=$(echo "$line" | cut -d'=' -f1 | xargs)
        pip install --upgrade "$package"
    done < requirements.txt
    devreq
}

devdoc(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    log "Documentation Server" title
    if command -v pdoc &>/dev/null; then
        pdoc --http :
    elif command -v mkdocs &>/dev/null; then
        mkdocs serve
    else
        log "No doc tool found. Install pdoc with: pip install pdoc" error
        return 1
    fi
}

devprofile(){
    if [[ "$DEV_STARTED" != "True" ]]; then
        return
    fi
    if [[ -z "$1" ]]; then
        log "Usage: devprofile <script.py>" error
        return 1
    fi
    log "Profiling $1" title
    python -m cProfile -s cumulative "$1"
}

devhelp(){

    log "Help Menu" title
    echo "Command                   Description"
    echo "source devstart           Activate venv (creates if not exists) and install requirements"
    echo "source devstart -f        Recreate .venv from scratch and install requirements"
    echo "source devstart -v X.Y    Create/activate venv using Python X.Y (recreates if version differs)"
    echo "devstop                   Deactivate devstart script"
    echo "devclean                  Clean all pycache and temporary python files"
    echo "devpack                   Export the current project to a zip file"
    echo "devreq                    Pin all installed packages to requirements.txt"
    echo "devdeps                   Show outdated packages"
    echo "devupgrade                Upgrade all packages in requirements.txt to latest"
    echo "devtest                   Run pytest (with coverage if pytest-cov is installed)"
    echo "devlint                   Lint with ruff (fallback: flake8)"
    echo "devformat                 Format with ruff (fallback: black)"
    echo "devci                     Run full CI pipeline: format -> lint -> test"
    echo "devdoc                    Launch docs server with pdoc (fallback: mkdocs)"
    echo "devprofile <script.py>    Profile a script with cProfile"
    echo "jup                       Install and run Jupyter Notebook on current venv"
}

#================================
# Main
#================================

_script_dir() {
    local src="${BASH_SOURCE[0]}"
    while [ -L "$src" ]; do
        local d; d="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" != /* ]] && src="$d/$src"
    done
    cd -P "$(dirname "$src")" && pwd
}

_shell_rc() {
    case "$(basename "$SHELL")" in
        zsh)  echo "${HOME}/.zshrc" ;;
        bash)
            [[ "$(uname)" == "Darwin" ]] \
                && echo "${HOME}/.bash_profile" \
                || echo "${HOME}/.bashrc" ;;
        *)    echo "${HOME}/.profile" ;;
    esac
}

_get_venv_python_version() {
    local venv_dir="$1"
    if [[ -f "${venv_dir}/bin/python" ]]; then
        "${venv_dir}/bin/python" --version 2>&1 | sed 's/Python //' | cut -d. -f1,2
    fi
}

SCRIPT_BIN_DIRECTORY=$(_script_dir)
SCRIPT_BASE_DIRECTORY=$(dirname "$SCRIPT_BIN_DIRECTORY")

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    SHELL_RC=$(_shell_rc)
    echo "Checking PATH on ${SHELL_RC}..."

    if ! grep -q "export PATH=.*$SCRIPT_BIN_DIRECTORY" "$SHELL_RC"; then
        # Copying .env file
        echo "Copying .env file to '${HOME}/.env-crema-script'..."
        cp -v "${SCRIPT_BASE_DIRECTORY}/.env" "${HOME}/.env-crema-script"

        # Adding bin to shell rc file
        echo "Configuring '$SCRIPT_BIN_DIRECTORY' to PATH on file ${SHELL_RC}..."
        echo "export PATH=\"\$PATH:$SCRIPT_BIN_DIRECTORY\"" >> "$SHELL_RC"
        echo "Crema Script has been configured in ${SHELL_RC}. To use it, restart your terminal session and run: 'source devstart' in your Python project directory."
        exit
    fi
fi

. "${SCRIPT_BASE_DIRECTORY}/lib/lib.sh"
. "${HOME}/.env-crema-script"

project_name=$(basename "$PWD")

log "Python DevStart" intro "1.0"

current_venv_dir=".venv"

force_recreate=false
requested_version=""
OPTIND=1
while getopts "fv:" opt; do
    case $opt in
        f) force_recreate=true ;;
        v) requested_version="$OPTARG" ;;
    esac
done
unset opt

if [[ -n "$requested_version" ]]; then
    requested_version=$(echo "$requested_version" | grep -oP '^\d+\.\d+')
fi

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "You need to execute devstart with '.' or source."
    echo "Example: . devstart"
    exit 0
fi

log "Preparing Python development environment..." title

if [[ ! -f requirements.txt ]]; then
    log "Error: requirements.txt not found." warn
    return
fi

if [[ "$DEV_STARTED" == "True" ]] && [[ "$force_recreate" != "true" ]]; then
    return
fi

_OLD_PS1="${PS1:-}"
PS1="devstart[\$(git branch --show-current 2>/dev/null)]->${_OLD_PS1:-}"
export PS1
DEV_STARTED="True"
export DEV_STARTED

if [[ -n "$requested_version" ]] && [[ "$force_recreate" != "true" ]] && [[ -d "${current_venv_dir}" ]]; then
    current_py_version=$(_get_venv_python_version "${current_venv_dir}")
    if [[ "$current_py_version" != "$requested_version" ]]; then
        log "Venv Python version ($current_py_version) differs from requested ($requested_version). Recreating..." title
        force_recreate=true
    fi
fi

if [[ "$VIRTUAL_ENV" != "" ]]; then
    log "Deactivating current venv..." title
    deactivate
fi

if [[ "$force_recreate" == "true" ]] && [[ -d "${current_venv_dir}" ]]; then
    log "Removing venv dir ('${current_venv_dir}')..." title
    rm -Rfv "${current_venv_dir}"
fi

if [[ ! -d "${current_venv_dir}" ]]; then
    log "Creating new venv..." title
    if [[ -n "$requested_version" ]]; then
        python_cmd="python${requested_version}"
        if ! command -v "$python_cmd" &>/dev/null; then
            log "Error: $python_cmd not found. Install it before using -v ${requested_version}." error
            return 1
        fi
    else
        python_cmd="python3"
    fi
    "$python_cmd" -m venv "${current_venv_dir}"
fi
source "${current_venv_dir}/bin/activate"

log "Installing equirements..." title
pip install -r requirements.txt

log "Virtual Environment '$project_name' was configured." success